# ─── SERVER ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MONGODB ───────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/rebelive?retryWrites=true&w=majority"

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── GOOGLE OAUTH ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── REDIS ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CLIENT ────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── RATE LIMITING ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
