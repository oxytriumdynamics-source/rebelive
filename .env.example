# ─── SERVER ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MONGODB ───────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/rebelive?retryWrites=true&w=majority"

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── GOOGLE OAUTH ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── REDIS ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CLIENT ────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── RATE LIMITING ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── NODEMAILER / GMAIL OAUTH2 ────────────────────────
MAIL_CLIENT_ID=your_gmail_oauth_client_id
MAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
MAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
MAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
MAIL_FROM_EMAIL=support@rebelive.co
MAIL_FROM_NAME=REBELIVE

# ─── SHIPROCKET & FASTRR CHECKOUT ─────────────────────
SR_API_EMAIL=your_shiprocket_email
SR_API_PASSWORD="your_shiprocket_password"
SR_PICKUP_LOCATION=Primary
SR_PICKUP_PINCODE=143001
SR_WEBHOOK_TOKEN=your_shiprocket_webhook_token
SR_CHECKOUT_API_KEY=your_fastrr_api_key
SR_CHECKOUT_API_SECRET=your_fastrr_api_secret
SR_CHECKOUT_TOKEN_URL=
SR_CHECKOUT_ORDER_URL=
SR_CHECKOUT_WEBHOOK_SIG_HEADER=x-api-hmac-sha256

# ─── CLOUDINARY IMAGE STORAGE ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
